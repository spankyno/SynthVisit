# Puerto del servidor backend Express (por defecto 3000 o asignado por Render)
PORT=3000

# Entorno: 'development' o 'production'
NODE_ENV=production

# Autenticación para modo Headless (true / false)
REQUIRE_AUTH=false

# Clave secreta o token para autorizar campañas Headless en el servidor (opcional)
HEADLESS_AUTH_KEY=tu_token_secreto_aqui

# (Opcional) Desactivar HMR en Vite durante desarrollo
DISABLE_HMR=false
